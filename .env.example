# typesafe-comment environment configuration
#
# This file is a template. Copy it to ".env" and fill in your real values.
# The real .env file must NEVER be committed (it is already in .gitignore).
#
#   cp .env.example .env
#   $EDITOR .env
#
# The API key is read from the process environment. Set it directly, or load
# it from a file with: typesafe-comment --env ./path/to/.env <files...>
# The CLI also checks the general environment first; values found there take
# precedence over anything in a .env file (so CI/GitHub Actions secrets and
# `export TYPESAFE_API_KEY=...` always win).

# Required: your TypeSafe API key.
# Get one at https://console.typesafe.ai (API Keys).
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: model used for evaluation. Defaults to "jev-latest".
# See https://docs.typesafe.ai/models for the available models and aliases.
# TYPESAFE_MODEL=jev-latest

# Optional: HTTP endpoint base. Defaults to https://api.typesafe.ai
# Override for a proxy or self-hosted gateway.
# TYPESAFE_API_BASE=https://api.typesafe.ai

# Optional: per-request timeout in seconds for the TypeSafe API call.
# Defaults to 60.
# TYPESAFE_TIMEOUT=60

# Optional: maximum number of HTTP retries on 429/529/5xx (exponential backoff).
# Defaults to 4.
# TYPESAFE_MAX_RETRIES=4
